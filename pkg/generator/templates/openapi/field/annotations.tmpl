{{ define "openapi/field/annotations" }}
    {{- $field := . }}
    {{- $module := $.Module }}
    {{- $pkgPath := $.PkgPath }}

    {{- if $.Field }}
        {{- $field = $.Field }}
        {{- $module = $.Module }}
        {{- $pkgPath = $.PkgPath }}
    {{- end }}

    {{- range $oa := $field.OaAnnotations }}
        {{- if eq $oa.Type "title" }}
            prop.Title = {{ oaString $oa.Value }}
        {{ else if eq $oa.Type "description" }}
            prop.Description = {{ oaString $oa.Value }}
        {{ else if eq $oa.Type "example" }}
            {{- $oaType := ToOpenAPIType (trimStar $field.Type.Name) -}}
            prop.Example = {{ toExampleValue (trimQuotes $oa.Value) $oaType }}
        {{ else if eq $oa.Type "format" }}
            {{- if eq $oa.Value "email" }}
                prop.Format = "email"
            {{- else if eq $oa.Value "phone" }}
                prop.Format = "phone"
            {{- else if eq $oa.Value "uuid" }}
                prop.Format = "uuid"
            {{- else }}
                prop.Format = {{ oaString $oa.Value }}
            {{- end }}

        {{ else if eq $oa.Type "oneOf" }}
            {{- $clean := trimQuotes $oa.Value }}
            prop.OneOf = []*oa.Schema{
            {{- range $t := split $clean "," }}
                {{- $typeName := trimQuotes (trim $t) }}
                {{- $ref := buildGlobalRef $typeName $.PkgPath $.Module }}
                {Ref: "#/components/schemas/{{ $ref }}"},
            {{- end }}
            }

        {{ else if eq $oa.Type "oneOf-ref" }}
            {{- $clean := trimQuotes $oa.Value }}
            prop.OneOf = []*oa.Schema{
            {{- range $r := split $clean "," }}
                {{- $ref := trimQuotes (trim $r) }}
                {Ref: {{ printf "%q" $ref }}},
            {{- end }}
            }

        {{ else if eq $oa.Type "anyOf" }}
            {{- $clean := trimQuotes $oa.Value }}
            prop.AnyOf = []*oa.Schema{
            {{- range $t := split $clean "," }}
                {{- $typeName := trimQuotes (trim $t) }}
                {{- $ref := buildGlobalRef $typeName $.PkgPath $.Module }}
                {Ref: "#/components/schemas/{{ $ref }}"},
            {{- end }}
            }

        {{ else if eq $oa.Type "anyOf-ref" }}
            {{- $clean := trimQuotes $oa.Value }}
            prop.AnyOf = []*oa.Schema{
            {{- range $r := split $clean "," }}
                {{- $ref := trimQuotes (trim $r) }}
                {Ref: {{ printf "%q" $ref }}},
            {{- end }}
            }
        {{ else if eq $oa.Type "enum" }}
            {{- $enumStr := trimQuotes $oa.Value }}
            {{- $oaType := ToOpenAPIType (trimStar $field.Type.Name) -}}
            prop.Enum = []any{
            {{- range $val := splitList $enumStr "," -}}
                {{- $cleanVal := trimQuotes $val -}}
                {{- if eq $oaType "string" }}
                    {{ printf "%q" $cleanVal }},
                {{- else if or (eq $oaType "integer") (eq $oaType "number") }}
                    {{ $cleanVal }},
                {{- else }}
                    {{ printf "%q" $cleanVal }},
                {{- end }}
            {{- end }}
            }
        {{- end }}
    {{- end }}
{{ end }}
